# THIS FILE IS MANAGED BY PUPPET
# DO NOT EDIT MANUALLY!
LOGLEVEL = <%= $puppetboard::python_loglevel.to_python %>
PUPPETDB_HOST = <%= $puppetboard::puppetdb_host.to_python %>
PUPPETDB_PORT = <%= $puppetboard::puppetdb_port.to_python %>
PUPPETDB_SSL_VERIFY = <%= $puppetboard::puppetdb_ssl_verify.to_python %>
<%- if $puppetboard::puppetdb_key { -%>
PUPPETDB_KEY = <%= $puppetboard::puppetdb_key.to_python %>
<%- }-%>
<%- if $puppetboard::puppetdb_cert { -%>
PUPPETDB_CERT = <%= $puppetboard::puppetdb_cert.to_python %>
<%- } -%>
PUPPETDB_TIMEOUT = <%= $puppetboard::puppetdb_timeout.to_python %>
UNRESPONSIVE_HOURS = <%= $puppetboard::unresponsive.to_python %>
ENABLE_CATALOG = <%= $puppetboard::enable_catalog.to_python %>
ENABLE_QUERY = <%= $puppetboard::enable_query.to_python %>
LOCALISE_TIMESTAMP = <%= $puppetboard::localise_timestamp.to_python %>
OFFLINE_MODE = <%= $puppetboard::offline_mode.to_python %>
DEFAULT_ENVIRONMENT = <%= $puppetboard::default_environment.to_python %>
REPORTS_COUNT = <%= $puppetboard::reports_count.to_python %>
<%- if $puppetboard::secret_key { -%>
SECRET_KEY = <%= $puppetboard::secret_key.to_python %>
<%- } -%>
QUERY_PRESETS_FILE = <%= $puppetboard::query_presets_file.to_python %>
<%- $puppetboard::extra_settings.keys.sort.each |$key| { -%>
<%= $key %> = <%= $puppetboard::extra_settings[$key].to_python %>
<%- } -%>
