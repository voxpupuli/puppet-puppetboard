# THIS FILE IS MANAGED BY PUPPET
# DO NOT EDIT MANUALLY!
LOGLEVEL = <%= $puppetboard::python_loglevel.stdlib::to_python %>
PUPPETDB_HOST = <%= $puppetboard::puppetdb_host.stdlib::to_python %>
PUPPETDB_PORT = <%= $puppetboard::puppetdb_port.stdlib::to_python %>
PUPPETDB_SSL_VERIFY = <%= $puppetboard::puppetdb_ssl_verify.stdlib::to_python %>
<%- if $puppetboard::puppetdb_key { -%>
PUPPETDB_KEY = <%= $puppetboard::puppetdb_key.stdlib::to_python %>
<%- }-%>
<%- if $puppetboard::puppetdb_cert { -%>
PUPPETDB_CERT = <%= $puppetboard::puppetdb_cert.stdlib::to_python %>
<%- } -%>
PUPPETDB_TIMEOUT = <%= $puppetboard::puppetdb_timeout.stdlib::to_python %>
UNRESPONSIVE_HOURS = <%= $puppetboard::unresponsive.stdlib::to_python %>
ENABLE_CATALOG = <%= $puppetboard::enable_catalog.stdlib::to_python %>
ENABLE_QUERY = <%= $puppetboard::enable_query.stdlib::to_python %>
LOCALISE_TIMESTAMP = <%= $puppetboard::localise_timestamp.stdlib::to_python %>
OFFLINE_MODE = <%= $puppetboard::offline_mode.stdlib::to_python %>
DEFAULT_ENVIRONMENT = <%= $puppetboard::default_environment.stdlib::to_python %>
REPORTS_COUNT = <%= $puppetboard::reports_count.stdlib::to_python %>
<%- if $puppetboard::secret_key { -%>
SECRET_KEY = <%= $puppetboard::secret_key.stdlib::to_python %>
<%- } -%>
QUERY_PRESETS_FILE = <%= $puppetboard::query_presets_file.stdlib::to_python %>
<%- $puppetboard::extra_settings.keys.sort.each |$key| { -%>
<%= $key %> = <%= $puppetboard::extra_settings[$key].stdlib::to_python %>
<%- } -%>
